rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{d}   { allow read: if true; allow write: if request.auth != null; }
    match /activities/{d} { allow read: if true; allow write: if request.auth != null; }
    match /gallery/{d}    { allow read: if true; allow write: if request.auth != null; }
    match /team/{d}       { allow read: if true; allow write: if request.auth != null; }

    // Pendaftar: publik hanya boleh mengirim. Admin hanya boleh membaca,
    // menghapus, dan menambah foto / menautkan ke daftar anggota.
    // Biodata yang dikirim pendaftar TIDAK bisa diubah siapa pun.
    match /members/{d} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo','teamId']);
    }

    match /feedback/{d}   { allow create: if true; allow read, update, delete: if request.auth != null; }

    // Statistik kunjungan anonim: publik hanya boleh menulis dengan isian terbatas.
    match /visits/{d} {
      allow create: if request.resource.data.keys().hasOnly(['t','vid','nw','dev','tp','os','br','scr','lang','tz','ref','pg','net','bat','chg'])
        && request.resource.data.t == request.time
        && request.resource.data.vid is string && request.resource.data.vid.size() <= 32
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 90
        && request.resource.data.os is string && request.resource.data.os.size() <= 50
        && request.resource.data.br is string && request.resource.data.br.size() <= 50
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 100
        && request.resource.data.pg is string && request.resource.data.pg.size() <= 40
        && (request.resource.data.bat == null || request.resource.data.bat is number);
      allow read, delete: if request.auth != null;
    }
  }
}
